# b70-flash-next:tp2 — the image of the two-card engine (2x B70, TP 2 + EP 2, hot/cold experts; compose.yaml).
#
# Self-contained: everything is fetched and checked at build time, nothing has to be prepared on the host.
#
#   docker compose build            # or, from the REPOSITORY ROOT:
#   docker build -f image/Dockerfile.tp2 -t b70-flash-next:tp2 .
#
# = the official vLLM v0.30.0 XPU image (pinned by digest)
# + vllm-xpu-kernels 0.1.14.1+b70.3, downloaded from the 0.30.0-b70.2 release (sha256 asserted)
# + vLLM of the release 0.30.0-b70.2: fork tag Lumnus/vllm@v0.30.0-b70.2 (commit asserted; = v0.30.0 + patches
#   0001–0032), fetched into /workspace/vllm and its vllm/ changes copied into the installed package; the build fails
#   unless the release changes exactly the files patches/vllm/0001–0032 touch (less the two they restore, UPSTREAM)
# + the two-card patches 0040–0049 (in no release yet) from patches/vllm/, on top; then every touched file is
#   sha256-asserted against image/verify-overlay.sh ("final" set) and every touched .py compiled
# + libb70_moe_decode.so (patch 0048's fused decode MoE op), compiled in stage b70moe from kernels/b70-moe-decode with
#   icpx 2026.0 from Intel's apt repository
# + wu1ff's Level Zero peer-residency shim (no public source), copied from wu1ff's public image BY DIGEST and
#   sha256-asserted; engines/two-cards/env/tp2-hotcold.env LD_PRELOADs it
#
# wu1ff's libgdn_index64.so is NOT installed: with kernels b70.3 the stock GDN op is 64-bit (patches 0027, 0032).
# To run a vLLM source tree instead of the baked-in code (development), set PYTHONPATH=/work/<tree> in
# engines/two-cards/env/tp2-local.env.

ARG BASE_IMAGE=docker.io/vllm/vllm-openai-xpu:v0.30.0@sha256:fc0e112afb64e3a06fe8daff34652435822a629412f38efce8f0f67a46636b8d
ARG WU1FF_IMAGE=ghcr.io/wu1ff/qwen38-flashnext-b70:1.0.0@sha256:85512b52c09fa660a2e7fe441417129e7c47fac727fd85f66ccea6b65e0a9122

FROM ${WU1FF_IMAGE} AS wu1ff

# b70moe: the fused hot+cold decode MoE op of patch 0048 (kernels/b70-moe-decode), compiled against this image's
# torch with icpx 2026.0 (= its SYCL runtime, intel-sycl-rt 2026.0.0) from Intel's apt repository (key sha256
# asserted, package version pinned); ocloc for the AOT bmg target is in the base image. Only the .so is kept.
FROM ${BASE_IMAGE} AS b70moe
ARG ONEAPI_KEY_URL=https://apt.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB
ARG ONEAPI_KEY_SHA256=db932ba032a71f732dc415eef5f4f185fc7ae768487d7a357bc2772746b6c48c
ARG ONEAPI_COMPILER=intel-oneapi-compiler-dpcpp-cpp-2026.0=2026.0.0-947
RUN set -eu; \
    /opt/venv/bin/python -I -c 'import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])' \
      "${ONEAPI_KEY_URL}" /tmp/oneapi.pub; \
    echo "${ONEAPI_KEY_SHA256}  /tmp/oneapi.pub" | sha256sum -c -; \
    gpg --dearmor < /tmp/oneapi.pub > /usr/share/keyrings/oneapi-archive-keyring.gpg; \
    echo "deb [signed-by=/usr/share/keyrings/oneapi-archive-keyring.gpg] https://apt.repos.intel.com/oneapi all main" \
      > /etc/apt/sources.list.d/oneapi.list; \
    apt-get update -q; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends "${ONEAPI_COMPILER}"; \
    rm -rf /var/lib/apt/lists/*
RUN --mount=type=bind,source=kernels/b70-moe-decode,target=/src \
    set -eu; \
    set +u; . /opt/intel/oneapi/setvars.sh --force >/dev/null; set -u; \
    icpx --version | head -1; \
    bash /src/compile.sh /src /out/libb70_moe_decode.so /opt/venv/bin/python

FROM ${BASE_IMAGE}

# vllm-xpu-kernels 0.1.14.1+b70.3 (source: Lumnus/vllm-xpu-kernels tag v0.1.14.1+b70.3; docs/kernels.md)
ARG WHEEL=vllm_xpu_kernels-0.1.14.1+b70.3-cp38-abi3-manylinux_2_28_x86_64.whl
ARG WHEEL_URL=https://github.com/Lumnus/b70-flash-next/releases/download/v0.30.0-b70.2/vllm_xpu_kernels-0.1.14.1%2Bb70.3-cp38-abi3-manylinux_2_28_x86_64.whl
ARG WHEEL_SHA256=f104a3e5f61480681284ec3632e1a6692358b72a1fbdbda7406db0d7b7d1d589
RUN set -eu; \
    d=$(mktemp -d); \
    /opt/venv/bin/python -I -c 'import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])' \
      "${WHEEL_URL}" "$d/${WHEEL}"; \
    echo "${WHEEL_SHA256}  $d/${WHEEL}" | sha256sum -c -; \
    /opt/venv/bin/pip install --no-cache-dir --no-deps --force-reinstall "$d/${WHEEL}"; \
    rm -rf "$d"; \
    /opt/venv/bin/python -c "import importlib.metadata as m; v = m.version('vllm-xpu-kernels'); assert v == '0.1.14.1+b70.3', v"

# vLLM of the release, then the two-card patches. The image's /workspace/vllm is the v0.30.0 checkout (BASE); the
# release tag is fetched into it, and every vllm/ file the release adds, changes or removes is applied to the installed
# package the same way. --fuzz=0 and --dry-run for the patches on top, so a moved base fails loudly.
ARG VLLM_REPO=https://github.com/Lumnus/vllm.git
ARG VLLM_TAG=v0.30.0-b70.2
ARG VLLM_COMMIT=9d79d28d7e32f33bdbd115c85d116583ce679cb6
ARG VLLM_BASE=ced6857afa0ea7b2e3f0846a62e1394e90f15607
ARG TP2_PATCHES="0040 0041 0042 0043 0044 0045 0046 0047 0048 0049 0050 0052 0053"
RUN --mount=type=bind,source=patches/vllm,target=/tmp/b70-patches \
    --mount=type=bind,source=image,target=/tmp/b70-image \
    set -eu; export LC_ALL=C; \
    site=/opt/venv/lib/python3.12/site-packages; ws=/workspace/vllm; \
    git config --global --add safe.directory "$ws"; \
    test "$(git -C "$ws" rev-parse HEAD)" = "${VLLM_BASE}"; \
    git -C "$ws" fetch -q --depth 1 "${VLLM_REPO}" "refs/tags/${VLLM_TAG}:refs/tags/${VLLM_TAG}"; \
    got=$(git -C "$ws" rev-parse "${VLLM_TAG}^{commit}"); \
    [ "$got" = "${VLLM_COMMIT}" ] || { echo "tag ${VLLM_TAG} is $got, want ${VLLM_COMMIT}" >&2; exit 1; }; \
    git -C "$ws" checkout -q --force "${VLLM_TAG}"; \
    git -C "$ws" diff --name-only --no-renames "${VLLM_BASE}" "${VLLM_TAG}" -- vllm | sort > /tmp/release-files; \
    for p in /tmp/b70-patches/*.patch; do \
      case " ${TP2_PATCHES} " in *" $(basename "$p" | cut -c1-4) "*) continue ;; esac; \
      sed -n 's#^+++ b/\(vllm/[^[:space:]]*\).*#\1#p; s#^--- a/\(vllm/[^[:space:]]*\).*#\1#p' "$p"; \
    done | sort -u > /tmp/series-files; \
    sed -n 's#^[0-9a-f]\{64\}  UPSTREAM  *\(vllm/.*\)$#\1#p' /tmp/b70-image/verify-overlay.sh | sort > /tmp/upstream-files; \
    comm -23 /tmp/release-files /tmp/series-files > /tmp/only-release; \
    comm -13 /tmp/release-files /tmp/series-files | comm -23 - /tmp/upstream-files > /tmp/only-series; \
    if [ -s /tmp/only-release ] || [ -s /tmp/only-series ]; then \
      echo "release ${VLLM_TAG} and patches/vllm/ (without ${TP2_PATCHES}) differ; only in the release:" >&2; \
      cat /tmp/only-release >&2; echo "only in the patches (and not restored to upstream):" >&2; cat /tmp/only-series >&2; exit 1; \
    fi; \
    git -C "$ws" diff --name-status --no-renames "${VLLM_BASE}" "${VLLM_TAG}" -- vllm | while read -r st f; do \
      if [ "$st" = D ]; then rm -f "$site/$f"; else install -D -m 0644 "$ws/$f" "$site/$f"; fi; \
    done; \
    echo "vLLM ${VLLM_TAG} (${VLLM_COMMIT}): $(wc -l < /tmp/release-files) files -> $site and $ws"; \
    for root in "$site" "$ws"; do \
      for n in ${TP2_PATCHES}; do \
        p=$(ls /tmp/b70-patches/$n-*.patch); \
        patch -d "$root" -p1 --fuzz=0 --forward --no-backup-if-mismatch --dry-run -s < "$p" >/dev/null; \
        patch -d "$root" -p1 --fuzz=0 --forward --no-backup-if-mismatch -s < "$p"; \
      done; \
      echo "applied two-card patches ${TP2_PATCHES} -> $root"; \
    done; \
    if find "$site/vllm" "$ws/vllm" \( -name '*.orig' -o -name '*.rej' \) | grep -q .; then \
      echo "patch left .orig/.rej files" >&2; exit 1; \
    fi; \
    /opt/venv/bin/python -I /tmp/b70-image/verify-tree.py "$site" "$ws"; \
    cd "$site"; \
    PYTHONDONTWRITEBYTECODE=1 /opt/venv/bin/python -c 'import sys; [compile(open(f, "rb").read(), f, "exec") for f in sys.argv[1:]]; print("compiled", len(sys.argv) - 1, "files")' \
      $(for p in /tmp/b70-patches/*.patch; do sed -n 's#^+++ b/\(vllm/[^[:space:]]*\.py\).*#\1#p' "$p"; done | sort -u)

# 0048's fused decode MoE op (stage b70moe), next to b70_hotcold.py: B70_MOE_DECODE_OP=1 loads it. Loading it here
# checks that it links against this image's torch and SYCL runtime (no GPU needed).
COPY --from=b70moe --chmod=0755 /out/libb70_moe_decode.so \
     /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/fused_moe/libb70_moe_decode.so
RUN /opt/venv/bin/python -c "import torch; torch.ops.load_library('/opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/fused_moe/libb70_moe_decode.so'); print('b70moe op:', torch.ops.b70moe.moe_decode)"

# P7 — Level Zero peer-residency shim (without it Level Zero mirrors device memory into host RAM). wu1ff layer
# sha256:512b136c0deacc7459daf8226f7ce8143a14a782070f4fa6312c0e7185e60401.
COPY --from=wu1ff --chmod=0644 /opt/b70-residency-shim/libl0_peer_residency_shim.so /opt/b70-residency-shim/libl0_peer_residency_shim.so
RUN echo "ae2c82f549d97393268cbd7b90dba7cf38fd00dbccae54f090b1a545e5613b3c  /opt/b70-residency-shim/libl0_peer_residency_shim.so" | sha256sum -c -

LABEL org.opencontainers.image.title="b70-flash-next:tp2" \
      org.opencontainers.image.description="vLLM 0.30.0-b70.2 (Lumnus/vllm@v0.30.0-b70.2) + two-card patches 0040-0048 + kernels 0.1.14.1+b70.3 for 2x Arc Pro B70" \
      net.lumnus.vllm.release="v0.30.0-b70.2" \
      net.lumnus.vllm.commit="9d79d28d7e32f33bdbd115c85d116583ce679cb6" \
      org.opencontainers.image.source="https://github.com/Lumnus/b70-flash-next" \
      org.opencontainers.image.licenses="Apache-2.0 AND MIT"

WORKDIR /opt/venv
