+@needs_ckpt
+@pytest.mark.skipif(not os.path.exists(INT8), reason=f"no INT8 table at {INT8}")
+def test_real_fp8_rows_requantise_to_the_int8_table():
+    """End to end: row g read in place from the shards, re-quantised exactly
+    as tools/build_int8_ple_from_fp8.py does, is byte-equal to row g of the
+    INT8 table 0013 serves today. So the FP8 path serves the same rows in
+    the same order (only without the INT8 rounding)."""
+    store, segments = _real_store()
+    tensors = ne._b70_mmap_safetensors_any(CKPT)
+    _, scale, _ = ne._b70_ple_fp8_segments(tensors, REAL_VOCAB, ROW, REAL_PARTS)
+    data_start, shape, _ = pn.safetensors_tensor_location(INT8, "table")
+    int8 = pn.PleNvmeRowStore(INT8, data_start, 164, shape[0], reader="native")
+    try:
+        rng = np.random.default_rng(7)
+        rows = np.unique(rng.integers(0, REAL_VOCAB, 1500))
+        fp8 = torch.from_numpy(store.read_rows(rows))
+        x = fp8.view(torch.float8_e4m3fn).to(torch.float32) * float(scale[0])
+        s = x.abs().amax(1, keepdim=True) / 127.0
+        q = (x / s.clamp_min(1e-30)).round().clamp_(-127, 127).to(torch.int8)
+        want = torch.empty(rows.shape[0], 164, dtype=torch.uint8)
+        want[:, :ROW] = q.view(torch.uint8)
+        want[:, ROW:] = s.contiguous().view(torch.uint8).reshape(-1, 4)
+        assert np.array_equal(int8.read_rows(rows), want.numpy())
+        # And 0007's LUT dequant of those rows equals the stock cast-multiply.
+        lut = ne._b70_fp8_lut(scale)
+        got = ne._b70_fp8_dequantize_lut(lut, fp8.view(torch.float8_e4m3fn), torch.bfloat16)
+        stock = fp8.view(torch.float8_e4m3fn).to(torch.bfloat16) * scale.to(torch.bfloat16)
+        assert torch.equal(got, stock)
+    finally:
+        int8.close()
+        store.close()
+
+
+if __name__ == "__main__":
+    sys.exit(pytest.main(["--noconftest", "-q", __file__, *sys.argv[1:]]))
