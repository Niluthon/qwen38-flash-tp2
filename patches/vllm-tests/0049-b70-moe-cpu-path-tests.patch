Subject: [PATCH 2/2] B70-0049 tests: the CPU path switch and per-rank pinning
 (CPU only)

---
 tests/model_executor/test_b70_cpu_path.py | 62 +++++++++++++++++++++++
 1 file changed, 62 insertions(+)
 create mode 100644 tests/model_executor/test_b70_cpu_path.py

diff --git a/tests/model_executor/test_b70_cpu_path.py b/tests/model_executor/test_b70_cpu_path.py
new file mode 100644
index 0000000..4b77e96
--- /dev/null
+++ b/tests/model_executor/test_b70_cpu_path.py
@@ -0,0 +1,62 @@
+# SPDX-License-Identifier: Apache-2.0
+"""B70 0049: the decode op's CPU path switch and per-rank pinning (CPU only, no XPU needed)."""
+import pytest
+
+from vllm.model_executor.layers.fused_moe import b70_hotcold
+
+
+@pytest.fixture
+def cpu_env(monkeypatch):
+    for k in ("B70_MOE_CPU", "B70_MOE_CPU_FIRST_CORE", "B70_MOE_CPU_THREADS", "B70_MOE_CPU_PCT"):
+        monkeypatch.setenv(k, "x")  # records the original value, restored after the test (the code under test
+        monkeypatch.delenv(k)       # writes os.environ directly)
+
+    def setup(rank=0, avx512_bf16=True, **env):
+        for k, v in env.items():
+            monkeypatch.setenv(k, v)
+        monkeypatch.setattr("vllm.distributed.get_tensor_model_parallel_rank", lambda: rank)
+        monkeypatch.setattr(b70_hotcold, "_cpu_has_avx512_bf16", lambda: avx512_bf16)
+        b70_hotcold._cpu_path_setup()
+
+    return setup
+
+
+@pytest.mark.parametrize("value", [None, "0", "off"])
+def test_off_unless_one(cpu_env, monkeypatch, value):
+    env = {} if value is None else {"B70_MOE_CPU": value}
+    cpu_env(rank=1, **env)
+    import os
+    assert "B70_MOE_CPU_FIRST_CORE" not in os.environ
+
+
+def test_no_avx512_bf16_turns_it_off(cpu_env):
+    import os
+    cpu_env(rank=1, avx512_bf16=False, B70_MOE_CPU="1")
+    assert os.environ["B70_MOE_CPU"] == "0"
+    assert "B70_MOE_CPU_FIRST_CORE" not in os.environ
+
+
+@pytest.mark.parametrize("rank,first,want", [
+    (0, None, "0"), (1, None, "8"),          # default: 8 x rank
+    (0, "4", "4"), (1, "4", "4"),            # one number: every rank
+    (0, "0,6", "0"), (1, "0,6", "6"),        # a list: one per rank
+    (2, "0,8", "16"), (1, "3,", "8"),        # list too short / empty entry: the default
+])
+def test_first_core(cpu_env, rank, first, want):
+    import os
+    env = {"B70_MOE_CPU": "1"}
+    if first is not None:
+        env["B70_MOE_CPU_FIRST_CORE"] = first
+    cpu_env(rank=rank, **env)
+    assert os.environ["B70_MOE_CPU"] == "1"
+    assert os.environ["B70_MOE_CPU_FIRST_CORE"] == want
+
+
+def test_cpuinfo_flag_detection(monkeypatch, tmp_path):
+    import builtins
+    real_open = builtins.open
+    for flags, want in (("fpu avx512f avx512_bf16 sse", True), ("fpu avx512f avx2", False)):
+        p = tmp_path / "cpuinfo"
+        p.write_text(f"processor : 0\nflags\t\t: {flags}\n")
+        monkeypatch.setattr(builtins, "open", lambda f, *a, **k: real_open(p if f == "/proc/cpuinfo" else f, *a, **k))
+        assert b70_hotcold._cpu_has_avx512_bf16() is want
