From 0bafee973117220003fd9f28da4ece2b61f9d637 Mon Sep 17 00:00:00 2001
From: Niluthon <37350260+Niluthon@users.noreply.github.com>
Date: Sun, 11 Oct 2026 14:29:58 +0000
Subject: [PATCH] B70-0045: opt-in FP8 W8A16 for the 16-bit dense layers of INC
 checkpoints (B70_DENSE_FP8)

A 16-bit linear layer whose name matches the regex B70_DENSE_FP8 is quantized at load time to FP8 E4M3 with one
scale per output channel and run by the XPU weight-only kernel fp8_gemm_w8a16 (activations stay BF16); lm_head
never. Off by default.

Measured on 2x B70 (GDN in_proj_qkv/in_proj_z/out_proj and attention q/k/v/o): weights -0.9 GiB per card, KV
193,621 -> 251,771 tokens; perplexity +0.4-0.7 % (code, docs, Russian); needles 6/6; decode on general prompts
~5-7 % faster (one run each); agentic answers at temperature 0 ~20 % longer (more hit the token cap, no loops).
Not a default until a quality benchmark says so.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../layers/quantization/inc/inc.py            | 25 +++++++++++++--
 .../layers/quantization/online/fp8.py         | 31 +++++++++++++++++++
 2 files changed, 54 insertions(+), 2 deletions(-)

diff --git a/vllm/model_executor/layers/quantization/inc/inc.py b/vllm/model_executor/layers/quantization/inc/inc.py
index ab94895..b2e9a6e 100644
--- a/vllm/model_executor/layers/quantization/inc/inc.py
+++ b/vllm/model_executor/layers/quantization/inc/inc.py
@@ -328,7 +328,7 @@ class INCConfig(QuantizationConfig):
                     layer_name == prefix or layer_name == f"model.{prefix}"
                 ) and self.extra_config[layer_name].get("bits", 16) >= 16:
                     if isinstance(layer, (LinearBase, ParallelLMHead)):
-                        return UnquantizedLinearMethod()
+                        return _b70_dense_method(layer, prefix)
                     if isinstance(layer, RoutedExperts):
                         return UnquantizedFusedMoEMethod(layer.moe_config)
                     return None
@@ -336,7 +336,7 @@ class INCConfig(QuantizationConfig):
         layer_config = self.config_parser.resolve(layer, prefix)
         if not layer_config.quantized:
             if isinstance(layer, (LinearBase, ParallelLMHead)):
-                return UnquantizedLinearMethod()
+                return _b70_dense_method(layer, prefix)
             if isinstance(layer, RoutedExperts):
                 return UnquantizedFusedMoEMethod(layer.moe_config)
             return None
@@ -366,3 +366,24 @@ class INCConfig(QuantizationConfig):
         if is_auto_round_format:
             return cls.get_name()
         return None
+
+
+def _b70_dense_method(layer: torch.nn.Module, prefix: str):
+    """B70 0045: a 16-bit linear layer whose name matches B70_DENSE_FP8 (a regex) is
+    quantized at load time to FP8 E4M3 with one scale per output channel and run
+    by the XPU weight-only kernel (activations stay BF16). lm_head never."""
+    import os
+    import re
+
+    from vllm.platforms import current_platform
+
+    pattern = os.environ.get("B70_DENSE_FP8", "")
+    if (pattern and not isinstance(layer, ParallelLMHead) and re.search(pattern, prefix)
+            and current_platform.is_xpu()):
+        from vllm.model_executor.layers.quantization.online.fp8 import (
+            B70XpuFp8W8A16OnlineLinearMethod,
+        )
+
+        logger.info_once("B70 dense FP8: 16-bit linear layers matching %r run as FP8 W8A16", pattern)
+        return B70XpuFp8W8A16OnlineLinearMethod()
+    return UnquantizedLinearMethod()
diff --git a/vllm/model_executor/layers/quantization/online/fp8.py b/vllm/model_executor/layers/quantization/online/fp8.py
index 0234702..bb99e0d 100644
--- a/vllm/model_executor/layers/quantization/online/fp8.py
+++ b/vllm/model_executor/layers/quantization/online/fp8.py
@@ -786,3 +786,34 @@ class Fp8PtpcOnlineMoEMethod(_Fp8OnlineMoEBase):
         )
 
         layer._already_called_process_weights_after_loading = True
+
+
+class B70XpuFp8W8A16OnlineLinearMethod(Fp8PtpcOnlineLinearMethod):
+    """B70 0045: per-output-channel FP8 weights quantized at load time, run by the
+    XPU weight-only kernel (fp8_gemm_w8a16); activations are not quantized."""
+
+    def create_weights(
+        self,
+        layer: torch.nn.Module,
+        input_size_per_partition: int,
+        output_partition_sizes: list[int],
+        input_size: int,
+        output_size: int,
+        params_dtype: torch.dtype,
+        **extra_weight_attrs,
+    ):
+        from vllm.model_executor.kernels.linear.scaled_mm.xpu import XPUW8A16FP8LinearKernel
+
+        OnlineLinearBase.create_weights(
+            self, layer, input_size_per_partition, output_partition_sizes, input_size,
+            output_size, params_dtype, **extra_weight_attrs,
+        )
+        self.fp8_linear = init_fp8_linear_kernel(
+            activation_quant_key=self.activation_quant_key,
+            weight_quant_key=self.weight_quant_key,
+            weight_shape=layer.weight.shape,
+            input_dtype=self.input_dtype,
+            out_dtype=self.out_dtype,
+            force_kernel=XPUW8A16FP8LinearKernel,
+            module_name=self.__class__.__name__,
+        )
