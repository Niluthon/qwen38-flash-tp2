     return os.environ.get("B70_PLE_INT8_NVME_SYNC_ONLY", "0") == "1"
 
 
+def _ple_fp8_nvme_enabled() -> bool:
+    """B70 0050 gate: serve the checkpoint's FP8 PLE shards from NVMe in place.
+
+    Default OFF. On (requires B70_PLE_FP8=1): B70_PLE_FP8_PATH (a checkpoint
+    directory, its model.safetensors.index.json, or one .safetensors) is read
+    with O_DIRECT through 0013's row cache and host hook; no pinned table and
+    no INT8 copy. The B70_PLE_INT8_NVME_* tuning switches apply.
+    """
+    return os.environ.get("B70_PLE_FP8_NVME", "0") == "1"
+
+
+def _b70_ple_tensor_filter(path: str):
+    """Name filter for B70_PLE_FP8_PATH (0050): a directory or index.json
+    lists the whole checkpoint, so keep only the PLE embedding's tensors; a
+    single .safetensors file is the table file itself (all names)."""
+    if os.path.isdir(path) or path.endswith(".json"):
+        return lambda name: ".ple_embedding." in name
+    return None
+
+
+def _b70_mmap_safetensors_any(path: str) -> dict[str, torch.Tensor]:
+    """_b70_mmap_safetensors over one file, an index.json or a directory (0050).
+
+    In directory / index mode only the PLE embedding's tensors are kept,
+    from every file that holds one, and they must all share one prefix (one
+    PLE table). Keys are the full checkpoint names, which 0007's resolvers
+    already accept (``...shard_<i>.weight``, ``...weight_scale``, layout).
+    """
+    from .ple_nvme import safetensors_files_for
+
+    keep = _b70_ple_tensor_filter(path)
+    if keep is None:
+        return _b70_mmap_safetensors(path)
+    files = safetensors_files_for(path, keep)
+    if not files:
+        raise ValueError(f"{path}: no PLE embedding tensors in the index")
+    prefixes = {
+        name.split(".ple_embedding.", 1)[0] for names in files.values() for name in names
+    }
+    if len(prefixes) != 1:
+        raise ValueError(f"{path}: PLE tensors under {len(prefixes)} prefixes {sorted(prefixes)}")
+    tensors: dict[str, torch.Tensor] = {}
+    for file, names in files.items():
+        mapped = _b70_mmap_safetensors(file)
+        for name in names:
+            if name not in mapped:
+                raise ValueError(f"{file}: the index lists {name}, the file does not map it")
+            tensors[name] = mapped[name]
+    return tensors
+
+
