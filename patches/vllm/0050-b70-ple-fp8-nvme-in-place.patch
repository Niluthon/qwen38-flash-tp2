+    def _b70_fp8_nvme_load(
+        self,
+        path: str,
+        segments: list[tuple[int, torch.Tensor]],
+        scale: torch.Tensor,
+        layout: str,
+    ) -> bool:
+        """Boot the NVMe path for the checkpoint's FP8 shards (B70 0050).
+
+        The shards are read in place: the row store gets one segment per
+        shard tensor (its file, absolute data offset, first global row), so
+        nothing is copied or re-quantised at prepare time. Boot checks,
+        before any pinned memory is allocated:
+          * the reader's bytes equal the mmap's (``segments``, resolved and
+            validated by 0007) on 4,096 random rows of the whole table plus
+            the first and last row of every shard (tests the per-file offset
+            math, the unaligned data starts and page-crossing rows);
+          * no NaN code (E4M3fn 0x7F / 0xFF) in a random sample of this
+            rank's rows (B70_PLE_INT8_NVME_BOOT_SAMPLE, default 65,536);
+          * 0007's BF16 cross-check already ran (when PLE_TABLE_PATH is set).
+        """
+        import numpy as np
+
+        from .ple_nvme import (
+            PleNvmeRowStore,
+            fp8_nan_rows,
+            fp8_ple_locations,
+            fp8_ple_segments,
+        )
+
+        embedding = self.ngram_embedding
+        dim = embedding.embedding_dim
+        storage = embedding._b70_storage_dim
+        if storage != dim:
+            raise RuntimeError(f"FP8 PLE storage width {storage} != embedding dim {dim}")
+        vocab = embedding.org_vocab_size
+        locations = fp8_ple_locations(path, _b70_ple_tensor_filter(path))
+        file_segments = fp8_ple_segments(locations, vocab, dim, self.split_ngram_parts)
+        if [s[2] for s in file_segments] != [s[0] for s in segments]:
+            raise RuntimeError(
+                f"FP8 PLE NVMe: file segments {len(file_segments)} do not line up with the "
+                f"mmap's {len(segments)}"
+            )
+        io_threads = int(os.environ.get("B70_PLE_INT8_NVME_IO_THREADS", "16"))
+        reader = os.environ.get("B70_PLE_INT8_NVME_READER", "py")
+        try:
+            store = PleNvmeRowStore(
+                file_segments[0][0], file_segments[0][1], storage, vocab,
+                io_threads=io_threads, reader=reader, segments=file_segments,
+            )
+        except OSError as exc:
+            raise RuntimeError(
+                f"B70_PLE_FP8_NVME=1: cannot open the FP8 PLE shards of {path} with "
+                f"O_DIRECT: {exc}"
+            ) from exc
+        files = sorted({s[0] for s in file_segments})
+        logger.info(
+            "PLE FP8 NVMe load (B70_PLE_FP8_NVME=1) starting: %s, %d shards in %d files, "
+            "%d I/O threads, reader %s; %s",
+            path, len(file_segments), len(files), io_threads, reader, _host_memory_note(),
+        )
+        # Reader bytes == mmap bytes (whole table sample + every shard's ends).
+        generator = torch.Generator().manual_seed(20260928)
+        sample = torch.randint(0, vocab, (4096,), generator=generator).numpy()
+        ends = np.array(
+            [v for _, _, first, rows in file_segments for v in (first, first + rows - 1)],
+            dtype=np.int64,
+        )
+        rows = np.unique(np.concatenate([sample, ends]))
+        starts = np.array([s for s, _ in segments], dtype=np.int64)
+        seg_of = np.searchsorted(starts, rows, side="right") - 1
+        want = np.empty((rows.shape[0], storage), dtype=np.uint8)
+        for index in np.unique(seg_of).tolist():
+            pick = np.nonzero(seg_of == index)[0]
+            local = torch.from_numpy(rows[pick] - starts[index])
+            want[pick] = segments[index][1].view(torch.uint8).index_select(0, local).numpy()
+        got = store.read_rows(rows)
+        if not np.array_equal(got, want):
+            bad = int((got != want).any(axis=1).sum())
+            store.close()
+            raise ValueError(
+                f"FP8 PLE NVMe reader rows differ from the mmap of {path} ({bad} of "
+                f"{rows.shape[0]} rows; offset math or wrong file)"
+            )
+        # NaN codes in a sample of this rank's rows.
+        tp_start = embedding.shard_indices.org_vocab_start_index
+        tp_end = embedding.shard_indices.org_vocab_end_index
+        count = int(os.environ.get("B70_PLE_INT8_NVME_BOOT_SAMPLE", "65536"))
+        if count > 0 and tp_end > tp_start:
+            generator = torch.Generator().manual_seed(20260929 + tp_start)
+            own = torch.unique(
+                torch.randint(tp_start, tp_end, (count,), generator=generator)
+            ).numpy()
+            nan = fp8_nan_rows(store.read_rows(own))
+            if nan.size:
+                store.close()
+                raise ValueError(
+                    f"FP8 PLE table {path}: NaN codes in {nan.size} of this rank's "
+                    f"{own.shape[0]} sampled rows (first: row {int(own[nan[0]])})"
+                )
+        for file in files:
+            _b70_drop_page_cache(file)
+        # No pinned table: drop the (never written) pageable shard.
+        embedding.weight.data = torch.empty(0, storage, dtype=embedding.weight.dtype)
+        self._b70_nvme_setup(path, None, store=store, sync_only=False)
+        logger.info(
+            "Serving FP8 PLE table from NVMe in place, %s (%s): tp rows [%d, %d) of %d, "
+            "%d B/row, scale=%g; boot: %d rows byte-equal to the mmap, %d own rows "
+            "NaN-free; %s",
+            path, layout, tp_start, tp_end, vocab, storage, float(scale[0]),
+            rows.shape[0], count, _host_memory_note(),
+        )
         return True
 
