+# --------------------------------------------------------------------------
+# FP8 PLE shards of a checkpoint, located in place (0050)
+# --------------------------------------------------------------------------
+
+FP8_PLE_ROW_BYTES = 160
+_FP8_SHARD_RE = r"(?:^|\.)shard_(\d+)\.weight$"
+
+
+def _safetensors_header(path: str) -> tuple[int, dict]:
+    import json
+
+    with open(path, "rb") as handle:
+        header_len = int.from_bytes(handle.read(8), "little")
+        size = os.fstat(handle.fileno()).st_size
+        if header_len <= 0 or 8 + header_len > size:
+            raise ValueError(f"{path}: not a safetensors file (header {header_len})")
+        return 8 + header_len, json.loads(handle.read(header_len))
+
+
+def safetensors_files_for(path: str, keep=None) -> dict[str, list[str]]:
+    """{file: [tensor names]} for ``path`` = a .safetensors file, a
+    ``*.safetensors.index.json`` or a checkpoint directory with one.
+
+    ``keep(name) -> bool`` filters the names (the files listed are those with
+    at least one kept name); a single file lists all of its tensors.
+    """
+    import json
+
+    if os.path.isdir(path):
+        path = os.path.join(path, "model.safetensors.index.json")
+    if path.endswith(".json"):
+        with open(path) as handle:
+            weight_map = json.load(handle)["weight_map"]
+        folder = os.path.dirname(path)
+        out: dict[str, list[str]] = {}
+        for name, file in weight_map.items():
+            if keep is None or keep(name):
+                out.setdefault(os.path.join(folder, file), []).append(name)
+        return {k: sorted(v) for k, v in sorted(out.items())}
+    _, header = _safetensors_header(path)
+    names = [k for k in header if k != "__metadata__" and (keep is None or keep(k))]
+    return {path: sorted(names)}
+
+
+def fp8_ple_locations(path: str, keep=None) -> dict[str, tuple[str, int, str, list[int]]]:
+    """name -> (file, absolute byte offset, dtype, shape) for the PLE tensors."""
+    out: dict[str, tuple[str, int, str, list[int]]] = {}
+    for file, names in safetensors_files_for(path, keep).items():
+        data_start, header = _safetensors_header(file)
+        size = os.path.getsize(file)
+        for name in names:
+            if name not in header:
+                raise ValueError(f"{file}: the index lists {name}, the file does not have it")
+            info = header[name]
+            begin, end = (int(v) for v in info["data_offsets"])
+            if begin < 0 or end < begin or data_start + end > size:
+                raise ValueError(f"{file}: tensor {name} offsets [{begin}, {end}) outside the file")
+            if name in out:
+                raise ValueError(f"PLE tensor {name} appears in {out[name][0]} and {file}")
+            out[name] = (file, data_start + begin, str(info["dtype"]),
+                         [int(v) for v in info["shape"]])
+    return out
+
+
+def fp8_ple_segments(
+    locations: dict[str, tuple[str, int, str, list[int]]],
+    org_vocab_size: int,
+    embedding_dim: int,
+    split_ngram_parts: int,
+) -> list[tuple[str, int, int, int]]:
+    """Row-store segments (file, data_start, first_row, rows) of the FP8 table.
+
+    Same layouts as 0007's ``_b70_ple_fp8_segments``: one ``table`` tensor
+    [>= org_vocab_size, dim], or the checkpoint's ``...shard_<i>.weight``
+    tensors (ceil(org_vocab_size / parts) rows each, the last one shorter),
+    all F8_E4M3 [*, dim]. Anything else raises. A ``table`` longer than
+    org_vocab_size is cut to org_vocab_size rows.
+    """
+    import re
+
+    def check(name: str, rows: int | None) -> tuple[str, int, int]:
+        file, start, dtype, shape = locations[name]
+        if dtype != "F8_E4M3":
+            raise ValueError(f"FP8 PLE tensor {name} is {dtype}, expected F8_E4M3")
+        if len(shape) != 2 or shape[1] != embedding_dim:
+            raise ValueError(
+                f"FP8 PLE tensor {name} has shape {shape}, expected [*, {embedding_dim}]"
+            )
+        if rows is not None and shape[0] != rows:
+            raise ValueError(f"FP8 PLE tensor {name} has {shape[0]} rows, expected {rows}")
+        return file, start, shape[0]
+
+    if "table" in locations:
+        file, start, rows = check("table", None)
+        if rows < org_vocab_size:
+            raise ValueError(f"FP8 PLE table has {rows} rows, expected >= {org_vocab_size}")
+        return [(file, start, 0, int(org_vocab_size))]
+    shard_re = re.compile(_FP8_SHARD_RE)
+    shards: dict[int, str] = {}
+    for name in locations:
+        match = shard_re.search(name)
+        if match:
+            index = int(match.group(1))
+            if index in shards:
+                raise ValueError(f"FP8 PLE shard {index} appears twice ({shards[index]}, {name})")
+            shards[index] = name
+    shard_size = (org_vocab_size + split_ngram_parts - 1) // split_ngram_parts
+    expected = [
+        i for i in range(split_ngram_parts)
+        if min(shard_size, org_vocab_size - i * shard_size) > 0
+    ]
+    if sorted(shards) != expected:
+        raise ValueError(
+            f"FP8 PLE files need 'table' or shards {expected[0]}..{expected[-1]} "
+            f"(split_ngram_parts={split_ngram_parts}); found {len(shards)} shard keys"
+        )
+    segments = []
+    for index in expected:
+        first = index * shard_size
+        rows = min(shard_size, org_vocab_size - first)
+        file, start, _ = check(shards[index], rows)
+        segments.append((file, start, first, rows))
+    return segments
+
+
+def fp8_nan_rows(rows: np.ndarray) -> np.ndarray:
+    """Indices of uint8 [n, d] FP8 E4M3 (fn) rows holding a NaN code
+    (0x7F / 0xFF; E4M3fn has no infinities)."""
+    return np.nonzero(((rows & 0x7F) == 0x7F).any(axis=1))[0]
+
