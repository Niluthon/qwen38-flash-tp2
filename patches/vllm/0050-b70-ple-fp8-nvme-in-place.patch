 _B70_PLE_INT8_FORMAT = "lumnus-ple-int8-rowscale/v1"
@@ -1311,6 +1362,9 @@ class Qwen4ExpPLEPinnedHostEmbedding(Qwen4ExpPLEEmbedding):
