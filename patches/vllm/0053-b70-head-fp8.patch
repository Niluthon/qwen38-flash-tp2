From a49ffd2dfea1f8b71a2c6e9737100d376063e9af Mon Sep 17 00:00:00 2001
From: Niluthon <37350260+Niluthon@users.noreply.github.com>
Date: Tue, 20 Oct 2026 19:55:42 +0000
Subject: [PATCH] B70-0053: the target's lm_head as FP8 W8A16 on the draft's
 copy, BF16 shard released (B70_HEAD_FP8)

B70_HEAD_FP8=1 (XPU): the target computes its logits with 0048's FP8 lm_head (E4M3, one scale per vocab row,
fp8_gemm_w8a16) and releases its BF16 shard: -0.59 GiB per card at TP 2, verify pass 1.07 -> 0.55 ms.
Off by default.

- mtp.py: b70_fp8_head_of(lm_head, release_bf16) builds the FP8 copy once per head module and caches it on the
  module, so target and draft (which share the module) share one copy. With release_bf16 the BF16 weight goes to
  host memory and is released on the device before the FP8 copy is built (the two never coexist in VRAM). The
  draft's _b70_prepare_draft_head uses it (0048 alone: unchanged).
- model.py: Qwen4ExpForCausalLM._b70_head_fp8_once at the first forward (also from
  Qwen4ExpForConditionalGeneration.forward) or compute_logits: the eager memory-profile run, after the drafter
  shared the head and before any activation, so vLLM's profile sees the shard gone (released inside
  compute_logits it would stay in the profile's torch peak: no KV gain). One log line with torch allocated
  before/after.

Two B70s (docs/two-cards.md round 12): KV 379,356 -> 400,513 tokens; card-0 free VRAM at peak under load
518 -> 815 MiB (vLLM no longer hides the draft copy's 0.3 GiB inside the activation estimate); bench_det
1 stream 34.0/31.5/33.6/31.3 -> 33.5/31.7/33.0/30.5 ms/step, 4 streams 176-177 -> 182-187 tok/s, agents and
prefill unchanged. Quality vs BF16 head: MMLU 87.50 -> 87.70 % (3,000 paired, 18 vs 24 discordant, McNemar
p = 0.44), HumanEval 158 -> 158 / 164 (same tasks), paired perplexity within +-1 %. CPU tests 7/7.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 vllm/models/qwen4_exp/nvidia/model.py | 45 ++++++++++++++++++++
 vllm/models/qwen4_exp/nvidia/mtp.py   | 59 ++++++++++++++++++++-------
 2 files changed, 89 insertions(+), 15 deletions(-)

diff --git a/vllm/models/qwen4_exp/nvidia/model.py b/vllm/models/qwen4_exp/nvidia/model.py
index b5e3c93..a8252d9 100644
--- a/vllm/models/qwen4_exp/nvidia/model.py
+++ b/vllm/models/qwen4_exp/nvidia/model.py
@@ -702,6 +702,7 @@ class Qwen4ExpForCausalLM(
         inputs_embeds: torch.Tensor | None = None,
         **kwargs: object,
     ) -> torch.Tensor | IntermediateTensors:
+        self._b70_head_fp8_once()
         # Forward kwargs unchanged so the runner's _maybe_add_ngram_kwargs
         # path (query_start_loc / ngram_context) reaches Qwen4ExpModel.
         return self.model(
@@ -839,8 +840,51 @@ class Qwen4ExpForCausalLM(
         )
 
     def compute_logits(self, hidden_states: torch.Tensor) -> torch.Tensor | None:
+        self._b70_head_fp8_once()
         return self.logits_processor(self.lm_head, hidden_states)
 
+    def _b70_head_fp8_once(self) -> None:
+        """B70 0053: run _b70_prepare_head_fp8 once, at the first forward (or compute_logits) call.
+
+        That is the eager memory-profile run, after load_model (the drafter has shared this head by then) and before
+        any activation: released there, the BF16 shard leaves both the profile's consumed memory and its torch peak
+        (released inside compute_logits it would still count in the peak, i.e. no KV gain)."""
+        if not getattr(self, "_b70_head_fp8_checked", False):
+            self._b70_head_fp8_checked = True
+            self._b70_prepare_head_fp8()
+
+    def _b70_prepare_head_fp8(self) -> None:
+        """B70 0053 (B70_HEAD_FP8=1): the target's lm_head shard runs as FP8 W8A16 and its BF16 weight is released.
+
+        The FP8 copy is 0048's (E4M3, one scale per vocab row, fp8_gemm_w8a16), shared with the MTP draft through
+        the shared head module, so the draft's own copy is not built twice. Saves the BF16 shard (0.59 GiB per card
+        at TP 2) and ~0.5 ms per verify pass (1.07 -> 0.55 ms at 1-4 rows). Changes the target's logits (rel L2
+        ~2.5e-2 per GEMM): a quality-gated switch, off by default."""
+        import os
+
+        from vllm.logger import init_logger
+        from vllm.platforms import current_platform
+
+        if os.environ.get("B70_HEAD_FP8", "0") != "1" or not current_platform.is_xpu():
+            return
+        from .mtp import b70_fp8_head_of
+
+        logger = init_logger(__name__)
+        head = self.lm_head
+        weight = head.weight
+        released = weight.numel() * weight.element_size()
+        alloc0 = torch.accelerator.memory_allocated(weight.device)
+        head8 = b70_fp8_head_of(head, release_bf16=True)
+        if head8 is None:
+            logger.warning("B70 head FP8: no BF16 lm_head weight; off")
+            return
+        head.quant_method = head8
+        alloc1 = torch.accelerator.memory_allocated(weight.device)
+        logger.info("B70 head FP8: target lm_head %d x %d as FP8 W8A16 (%.0f MB), BF16 shard released (%.0f MB); "
+                    "torch allocated %.2f -> %.2f GiB",
+                    head8.w8.shape[1], head8.w8.shape[0], head8.w8.numel() / 1e6, released / 1e6,
+                    alloc0 / 2**30, alloc1 / 2**30)
+
     def get_mtp_target_hidden_states(self) -> torch.Tensor | None:
         return self.model._mtp_hidden_buffer
 
@@ -1033,6 +1077,7 @@ class Qwen4ExpForConditionalGeneration(
         else:
             deepstack_input_embeds = None
 
+        self.language_model._b70_head_fp8_once()
         hidden_states = self.language_model.model(
             input_ids=input_ids,
             positions=positions,
diff --git a/vllm/models/qwen4_exp/nvidia/mtp.py b/vllm/models/qwen4_exp/nvidia/mtp.py
index ded8eb9..ee1c127 100644
--- a/vllm/models/qwen4_exp/nvidia/mtp.py
+++ b/vllm/models/qwen4_exp/nvidia/mtp.py
@@ -469,23 +469,16 @@ class Qwen4ExpMTP(nn.Module, SupportsPP, Qwen4ExpMixtureOfExperts):
 
         if os.environ.get("B70_DRAFT_HEAD_FP8", "0") != "1" or not current_platform.is_xpu():
             return
-        weight = getattr(getattr(self, "lm_head", None), "weight", None)
-        if weight is None or weight.dim() != 2 or weight.dtype != torch.bfloat16:
+        head = getattr(self, "lm_head", None)
+        shared = getattr(head, "_b70_fp8_head", None) is not None
+        head8 = b70_fp8_head_of(head) if head is not None else None
+        if head8 is None:
             logger.warning("B70 draft head FP8: no BF16 lm_head weight on the draft; off")
             return
-        rows, k = weight.shape
-        w8 = torch.empty((k, rows), dtype=torch.float8_e4m3fn, device=weight.device)
-        scale = torch.empty((1, rows), dtype=torch.float32, device=weight.device)
-        step = 8192
-        for i in range(0, rows, step):
-            chunk = weight[i : i + step].float()
-            s = chunk.abs().amax(dim=1).clamp(min=1e-12) / 448.0
-            w8[:, i : i + step] = (chunk / s[:, None]).t().to(torch.float8_e4m3fn)
-            scale[0, i : i + step] = s
-            del chunk
-        self._b70_head8 = _B70Fp8Head(w8, scale)
-        logger.info("B70 draft head FP8: %d x %d vocab shard as FP8 W8A16 for the draft passes (%.0f MB)",
-                    rows, k, w8.numel() / 1e6)
+        self._b70_head8 = head8
+        rows, k = head8.w8.shape[1], head8.w8.shape[0]
+        logger.info("B70 draft head FP8: %d x %d vocab shard as FP8 W8A16 for the draft passes (%.0f MB%s)",
+                    rows, k, head8.w8.numel() / 1e6, ", the target's (0053)" if shared else "")
 
     def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]) -> set[str]:
         def remap_weight_names():
@@ -528,4 +521,40 @@ class _B70Fp8Head:
         return out.reshape(*shape[:-1], -1)
 
 
+def b70_fp8_head_of(lm_head, release_bf16: bool = False) -> "_B70Fp8Head | None":
+    """B70 0048/0053: the FP8 (E4M3, one scale per vocab row) copy of an lm_head shard.
+
+    Built once per head module and cached on it (``lm_head._b70_fp8_head``), so the target (0053, B70_HEAD_FP8) and
+    the draft (0048, B70_DRAFT_HEAD_FP8), which share the module, share one copy whichever asks first. None when the
+    module has no BF16 weight. release_bf16 (0053): the BF16 weight is moved to host memory and released on the
+    device before the FP8 copy is built, so the two never coexist in VRAM (no extra torch peak during the
+    memory-profile run, which vLLM would otherwise reserve as activation memory)."""
+    head8 = getattr(lm_head, "_b70_fp8_head", None)
+    weight = getattr(lm_head, "weight", None)
+    if head8 is None:
+        if weight is None or weight.dim() != 2 or weight.dtype != torch.bfloat16 or weight.numel() == 0:
+            return None
+        rows, k = weight.shape
+        device = weight.device
+        src = weight.data
+        if release_bf16:
+            src = weight.data.to("cpu")
+            weight.data = torch.empty((0, k), dtype=weight.dtype, device=device)
+        w8 = torch.empty((k, rows), dtype=torch.float8_e4m3fn, device=device)
+        scale = torch.empty((1, rows), dtype=torch.float32, device=device)
+        step = 8192
+        for i in range(0, rows, step):
+            chunk = src[i : i + step].to(device).float()
+            s = chunk.abs().amax(dim=1).clamp(min=1e-12) / 448.0
+            w8[:, i : i + step] = (chunk / s[:, None]).t().to(torch.float8_e4m3fn)
+            scale[0, i : i + step] = s
+            del chunk
+        del src
+        head8 = _B70Fp8Head(w8, scale)
+        lm_head._b70_fp8_head = head8
+    if release_bf16 and weight is not None and weight.numel() != 0:
+        weight.data = torch.empty((0, weight.shape[1]), dtype=weight.dtype, device=weight.device)
+    return head8
+
+
 __all__ = ["Qwen4ExpMTP", "Qwen4ExpMultiTokenPredictor"]
