# Local overrides for the compose engine: copy to engines/two-cards/env/tp2-local.env (git-ignored) and uncomment what you change.
# Values here win over engines/tp2-hotcold.env. Apply with `docker compose up -d` (the engine restarts).
# Format: KEY=value, no quotes, no variable expansion (docker env-file rules).

# --- extra `vllm serve` flags (appended to engines/two-cards/args/serve-tp2.args; the last value of a flag wins) ---------------
# Shell-quoted; JSON values go in single quotes.
#EXTRA_ARGS=--max-model-len 65536 --gpu-memory-utilization 0.92
# 8 slots for many parallel agents (+8 % total throughput at 8 concurrent; KV 201K -> ~186K estimated, 193.6K -> 178.3K measured before 0045; docs/two-cards.md round 4):
#EXTRA_ARGS=--max-num-seqs 8 --compilation-config '{"cudagraph_mode":"FULL_AND_PIECEWISE","cudagraph_capture_sizes":[1,2,4,8,12,16,20,24,28,32]}'
#EXTRA_ARGS=--speculative-config '{"method":"mtp","num_speculative_tokens":3,"model":"/models/qwen38-w4a16-mtp-snapshot"}'

# --- routed experts (0040, 0043): VRAM vs host RAM -------------------------------------------------------------------
# Each hot expert costs 116 MiB of VRAM per card; check the "XPU KV cache size" boot line after a change.
#B70_MOE_HOT_EXPERTS=150
# 154 measured: +1-4 % decode for KV 201,794 -> 170,152 (docs/two-cards.md round 5)
#B70_MOE_HOT_EXPERTS=154
#B70_MOE_HOTCOLD_SWAP=1
#B70_MOE_HOTCOLD_SWAP_S=5
#B70_MOE_HOTCOLD_SWAP_DECAY=0.95
#B70_MOE_HOTCOLD_SWAP_BUDGET=8
#B70_MOE_HOTCOLD_SWAP_PRIOR=0.01
# 0047: rank by decode routes (needs B70_MOE_ROUTE_COUNT=1) or by prompt routes as before 0047 (prefill)
#B70_MOE_HOTCOLD_SWAP_SOURCE=decode
#B70_MOE_HOTCOLD_SWAP_PREFILL_W=0.1
# 0047: the learned ranking on the work volume; delete /work/hotcold-state-rank*.json to start from the checkpoint's
#B70_MOE_HOTCOLD_STATE=/work/hotcold-state
#B70_MOE_HOTCOLD_STATE_DECAY=0.999
#B70_MOE_HOTCOLD_STATE_S=300
# 0048 (on by default): 0 = the stock MoE path / the BF16 draft head; or a path to a self-built libb70_moe_decode.so
#B70_MOE_DECODE_OP=0
#B70_MOE_DECODE_OP_MAX_ROWS=16
#B70_DRAFT_HEAD_FP8=0

# --- decode: the CPU computes part of the cold experts (0049; needs AVX-512 BF16, else it stays off) ----------------
# 0 = every cold expert on the GPU (also settable as B70_MOE_CPU=0 in the root .env, which wins over this file)
#B70_MOE_CPU=0
#B70_MOE_CPU_PCT=70
#B70_MOE_CPU_THREADS=8
# first core per TP rank (default 8 x rank); e.g. a 12-core CPU: two pools of 6 threads
#B70_MOE_CPU_FIRST_CORE=0,6

# --- prefill: cold-expert prefetch (0042) ----------------------------------------------------------------------------
#B70_MOE_COLD_PREFETCH=1
#B70_MOE_COLD_PREFETCH_MIN_TOKENS=512

# --- input embedding in host RAM (0044) ------------------------------------------------------------------------------
#B70_EMBED_UVA=1

# --- FP8 W8A16 dense layers (0045; on by default; set empty to run them in BF16) -------------------------------------
#B70_DENSE_FP8=(linear_attn\.(in_proj_qkv|in_proj_z|in_proj_qkvz|out_proj)|self_attn\.(qkv_proj|q_proj|k_proj|v_proj|o_proj))$

# --- route counter / diagnostics (0041) ------------------------------------------------------------------------------
#B70_MOE_ROUTE_COUNT=1   # the default since 0047 (decode-aware swapping); `prefill` = nothing in the decode graphs
#B70_MOE_ROUTE_COUNT_S=60
#B70_MOE_ROUTE_COUNT_PATH=/work/routes

# --- PLE table from NVMe (0013) --------------------------------------------------------------------------------------
#B70_PLE_INT8_NVME_CACHE_GIB=2
#B70_PLE_INT8_NVME_STATS=1
# The default reads the checkpoint's FP8 PLE shards in place (0050). Fallback: the INT8 table (0008 + 0013), equal
# speed and perplexity (docs/two-cards.md round 10); build it first with BUILD_INT8_PLE=1 docker compose run --rm prepare.
#B70_PLE_FP8=0
#B70_PLE_FP8_NVME=0
#B70_PLE_INT8=1
#B70_PLE_INT8_NVME=1
#B70_PLE_INT8_PATH=/models/qwen38-w4a16-int8ple/ple_ngram_int8_rowscale.safetensors

# --- chat defaults (0009, 0010, 0012) ---------------------------------------------------------------------------------
#B70_THINKING_BUDGET=minimal=512,low=512,medium=2048,high=4096,xhigh=8192,max=12288,ultra=12288,default=8192
#B70_DEFAULT_PRESENCE_PENALTY=0

# --- other files ------------------------------------------------------------------------------------------------------
#MODEL_DIR=/models/qwen38-w4a16-snapshot
#SERVE_ARGS_FILE=/b70-engines/two-cards/args/serve-tp2.args
#ENGINE_LOG=/work/engine.log
