# tp2-hotcold — 2x Arc Pro B70 (32 GB each) + ~64 GB host RAM, TP 2 + EP 2 (read with `docker run --env-file`; no
# quotes, no variable expansion). Paths are container paths: /models = the model volume, /work = the work volume
# (caches, engine.log). The image (image/Dockerfile.tp2) carries the patched vLLM, the kernels and the shim.
# Weights: albucino/Qwen3.8-Flash-Next-W4A16-FP8PLE (Intel AutoRound target + FP8 PLE), snapshots from
# tools/fp8ple_snapshot.py; scripts/prepare-models-tp2.sh (`docker compose run --rm prepare`) does both. The two
# things this host needs beyond the 4-card recipe:
#   * routed experts that do not fit in VRAM live in pinned host RAM (B70_MOE_HOTCOLD, patch 0040);
#   * the PLE table is served from NVMe with a small row cache (0013), straight from the checkpoint's FP8 shards
#     (0050), no CPU KV tier (no RAM for it).

# Level Zero / oneCCL on 2 cards
ZE_AFFINITY_MASK=0,1
ZE_FLAT_DEVICE_HIERARCHY=FLAT
CCL_SYCL_ALLGATHERV_TMP_BUF=1
CCL_SYCL_ALLREDUCE_TMP_BUF=1
CCL_ZE_IPC_EXCHANGE=sockets
# P7: the peer-residency shim (without it Level Zero mirrors device memory into host RAM, which this host lacks)
LD_PRELOAD=/opt/b70-residency-shim/libl0_peer_residency_shim.so
VLLM_TARGET_DEVICE=xpu
VLLM_WORKER_MULTIPROC_METHOD=spawn
VLLM_XPU_ENABLE_XPU_GRAPH=1

#VLLM
VLLM_ALLOW_LONG_MAX_MODEL_LEN=0

# offline, caches on the work volume
HF_HUB_OFFLINE=1
HF_DATASETS_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HOME=/work/cache/hf
TMPDIR=/work/cache/tmp
TRITON_CACHE_DIR=/work/cache/triton
VLLM_CACHE_ROOT=/work/cache/vllm
XDG_CACHE_HOME=/work/cache/xdg

# routed experts: 150 of each rank's 256 per layer in VRAM, the rest pinned in host RAM (0040)
B70_MOE_HOTCOLD=1
B70_MOE_HOT_EXPERTS=146
B70_MOE_HOTCOLD_RANKINGS=/models/qwen38-w4a16/runtime/static_hot_cache_rankings.json
# prefill: batches >= 512 tokens run the cold experts from two VRAM slots, the next layer's DMA'd while this one
# computes (0042; 0.53 GiB per card; prefill ~2,600 -> ~3,950 tok/s; decode keeps the UVA path)
B70_MOE_COLD_PREFETCH=1
# the hot set follows the traffic: every 5 s up to 4 experts per layer swap between VRAM and pinned RAM by prefill
# route counts (0043; decode +16-30 % at 2 concurrent requests (code); nothing added to the decode graphs; KV unchanged)
B70_MOE_HOTCOLD_SWAP=1
# ...ranked by what decode reads, not by prompt tokens (0047): route counts inside the decode graphs (2 small kernels
# per layer, cost within noise), prefill routes at weight 0.1; decode cold share 8-10 -> 6-8 % (code agents), general
# prompts after code sessions 70 -> 114 tok/s at 4 streams. The long-term ranking is saved on the work volume every
# 5 min and places the hot set at the next boot (first requests after a restart +10 % at 1 stream).
B70_MOE_ROUTE_COUNT=1
B70_MOE_HOTCOLD_SWAP_SOURCE=decode
B70_MOE_HOTCOLD_STATE=/work/hotcold-state
# decode MoE: hot and cold experts in one fused SYCL op, each expert read once per layer, instead of two stock calls
# (0048; built into the image; batches <= 16 tokens) and the MTP draft passes on an FP8 copy of the lm_head (the
# target verifies with BF16; +318 MB per card, KV -7,600 tokens): 1 stream 61 -> 77 tok/s, 4 streams 112 -> 142
B70_MOE_DECODE_OP=1
B70_DRAFT_HEAD_FP8=1
# the target's lm_head runs on that same FP8 copy and its BF16 shard is released (0053): -0.59 GiB per card, KV
# 379K -> 400K tokens, verify pass 1.07 -> 0.55 ms; MMLU 87.50 -> 87.70 % (3,000 paired, p = 0.44), HumanEval
# 158 -> 158 / 164, paired ppl within +-1 % (docs/two-cards.md round 12)
B70_HEAD_FP8=1
# the decode op computes B70_MOE_CPU_PCT % of each layer's cold experts on the CPU pool (pinned host RAM: the GPU
# reads it at ~26 GB/s over PCIe, the CPU adds ~40 GB/s beside both cards; one pool per TP rank on its own 8 cores).
# 1 stream -16 % step time, 4 streams -19 % (170 vs 147 tok/s), agents +8-15 %, ppl within noise; on a GPU-wait
# timeout the op computes them itself and switches the path off (no hang, no wrong results)
B70_MOE_CPU=1
B70_MOE_CPU_PCT=70
# the input embedding table (0.59 GiB per card) lives in pinned host RAM; its VRAM holds 8 more hot experts (0044)
B70_EMBED_UVA=1
# the 16-bit GDN/attention projections run as FP8 W8A16 (0045): -0.9 GiB per card, which holds 6 more hot experts;
# MMLU 87.33 -> 87.23 % on 3,000 paired questions (p=0.79), HumanEval 157 -> 158/164
B70_DENSE_FP8=(linear_attn\.(in_proj_qkv|in_proj_z|in_proj_qkvz|out_proj)|self_attn\.(qkv_proj|q_proj|k_proj|v_proj|o_proj))$

# PLE table: the checkpoint's FP8 shards (0007) read in place from NVMe (0050, through 0013's host hook), 2 GiB
# pinned row cache in total. The B70_PLE_INT8_NVME_* tuning lines below apply to it. The INT8 table (0008 + 0013)
# is the fallback: B70_PLE_FP8=0 B70_PLE_FP8_NVME=0 B70_PLE_INT8=1 B70_PLE_INT8_NVME=1 B70_PLE_INT8_PATH=... in
# tp2-local.env (needs the table: tools/build_int8_ple_from_fp8.py, or BUILD_INT8_PLE=1 for prepare).
B70_PLE_DIRECT_PINNED=1
B70_PLE_INT8=0
B70_PLE_INT8_NVME=0
B70_PLE_FP8=1
B70_PLE_FP8_NVME=1
B70_PLE_FP8_PATH=/models/qwen38-w4a16
B70_PLE_INT8_NVME_CACHE_GIB=2
B70_PLE_INT8_NVME_IO_THREADS=16
B70_PLE_INT8_NVME_STATS=1
B70_PLE_INT8_NVME_READER=native
B70_PLE_INT8_NVME_LOOKAHEAD=0
B70_PLE_INT8_NVME_NATIVE_DIR=/work/cache/ple-nvme-native

# chat defaults (0009, 0010, 0012), as in common.env; no server presence penalty, as in s16-kv128-mtp3
B70_THINKING_BUDGET=minimal=512,low=512,medium=2048,high=4096,xhigh=8192,max=12288,ultra=12288,default=8192
B70_DEFAULT_PRESENCE_PENALTY=0
B70_DEFAULT_REPETITION_DETECTION=max=1,min=1,count=128
B70_REASONING_EFFORT_ALIAS=1

# MTP on XPU (0021): draft prefill uses FULL graphs only; mixed batches run the draft eagerly. The draft is the
# checkpoint's runtime/mtp-int4-g32 (routed experts int4 g32, compressed-tensors), snapshot from
# tools/fp8ple_snapshot.py --keep-quant; it stays fully in VRAM (0040 skips mtp layers).
B70_MTP_DRAFT_PREFILL_NO_PIECEWISE=1

# torch allocators: expandable_segments (device): loading no longer leaves ~1 GiB per card reserved but unusable
# (fragmentation), vLLM's profiling turns it into KV (271K -> 333K tokens, same peak VRAM under load; docs/two-cards.md
# round 12). pinned_max_cached_size_mb (host): 0031.
PYTORCH_ALLOC_CONF=expandable_segments:True,pinned_max_cached_size_mb:1024
