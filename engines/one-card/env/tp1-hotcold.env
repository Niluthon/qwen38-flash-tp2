# tp1-hotcold — 1x Arc Pro B70 (32 GB) + 96 GB host RAM, TP 1 (no expert parallel), hot/cold experts. NOT YET BOOTED:
# the sizes below are estimates from the two-card engine's boot log; check the boot lines and tune (engines/one-card/README.md).
# Format and paths as engines/two-cards/env/tp2-hotcold.env (docker env-file; container paths). Select it in the root .env:
#   ENGINE_ENV=engines/one-card/env/tp1-hotcold.env
#   ENGINE_LOCAL_ENV=engines/one-card/env/tp1-local.env
# Differences from tp2-hotcold: one card, 96 hot experts of 512 per layer, the serve flags in serve-tp1.args.

# Level Zero / oneCCL: one card (the CCL settings are inert at TP 1)
ZE_AFFINITY_MASK=0
ZE_FLAT_DEVICE_HIERARCHY=FLAT
CCL_SYCL_ALLGATHERV_TMP_BUF=1
CCL_SYCL_ALLREDUCE_TMP_BUF=1
CCL_ZE_IPC_EXCHANGE=sockets
# P7: the peer-residency shim (without it Level Zero mirrors device memory into host RAM, which this host lacks)
LD_PRELOAD=/opt/b70-residency-shim/libl0_peer_residency_shim.so
VLLM_TARGET_DEVICE=xpu
VLLM_WORKER_MULTIPROC_METHOD=spawn
VLLM_XPU_ENABLE_XPU_GRAPH=1

# offline, caches on the work volume
HF_HUB_OFFLINE=1
HF_DATASETS_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HOME=/work/cache/hf
TMPDIR=/work/cache/tmp
TRITON_CACHE_DIR=/work/cache/triton
VLLM_CACHE_ROOT=/work/cache/vllm
XDG_CACHE_HOME=/work/cache/xdg

# routed experts: 96 of 512 per layer in VRAM (11.1 GiB), the other 416 pinned in host RAM (47 GiB) (0040).
# Each expert = 116 MiB VRAM or RAM. VRAM decides the count: see engines/one-card/README.md
B70_MOE_HOTCOLD=1
B70_MOE_HOT_EXPERTS=96
B70_MOE_HOTCOLD_RANKINGS=/models/qwen38-w4a16/runtime/static_hot_cache_rankings.json
# prefill: batches >= 512 tokens run the cold experts from two VRAM slots, the next layer's DMA'd while this one
# computes (0042; at TP 1 with 416 cold the slots take ~2 GiB VRAM; =0 trades that for ~17 more hot experts and slower prefill)
B70_MOE_COLD_PREFETCH=1
# the hot set follows the traffic: every 5 s up to 4 experts per layer swap between VRAM and pinned RAM by prefill
# route counts (0043; agentic coding decode +16-30 %; nothing added to the decode graphs; KV unchanged)
B70_MOE_HOTCOLD_SWAP=1
# the input embedding table (0.59 GiB per card) lives in pinned host RAM; its VRAM holds 8 more hot experts (0044)
B70_EMBED_UVA=1
# the 16-bit GDN/attention projections run as FP8 W8A16 (0045): -0.9 GiB per card, which holds 6 more hot experts;
# MMLU 87.33 -> 87.23 % on 3,000 paired questions (p=0.79), HumanEval 157 -> 158/164
B70_DENSE_FP8=(linear_attn\.(in_proj_qkv|in_proj_z|in_proj_qkvz|out_proj)|self_attn\.(qkv_proj|q_proj|k_proj|v_proj|o_proj))$

# PLE table: INT8 (0008) from NVMe (0013), 2 GiB pinned row cache in total
B70_PLE_DIRECT_PINNED=1
B70_PLE_FP8=0
B70_PLE_INT8=1
B70_PLE_INT8_PATH=/models/qwen38-w4a16-int8ple/ple_ngram_int8_rowscale.safetensors
B70_PLE_INT8_NVME=1
B70_PLE_INT8_NVME_PATH=/models/qwen38-w4a16-int8ple/ple_ngram_int8_rowscale.safetensors
B70_PLE_INT8_NVME_CACHE_GIB=2
B70_PLE_INT8_NVME_IO_THREADS=16
B70_PLE_INT8_NVME_STATS=1
B70_PLE_INT8_NVME_READER=native
B70_PLE_INT8_NVME_LOOKAHEAD=0
B70_PLE_INT8_NVME_NATIVE_DIR=/work/cache/ple-nvme-native

# chat defaults (0009, 0010, 0012), as in common.env; no server presence penalty, as in s16-kv128-mtp3
B70_THINKING_BUDGET=minimal=512,low=512,medium=2048,high=4096,xhigh=8192,max=12288,ultra=12288,default=8192
B70_DEFAULT_PRESENCE_PENALTY=0
B70_DEFAULT_REPETITION_DETECTION=max=1,min=1,count=128
B70_REASONING_EFFORT_ALIAS=1

# MTP on XPU (0021): draft prefill uses FULL graphs only; mixed batches run the draft eagerly. The draft is the
# checkpoint's runtime/mtp-int4-g32 (routed experts int4 g32, compressed-tensors), snapshot from
# tools/fp8ple_snapshot.py --keep-quant; it stays fully in VRAM (0040 skips mtp layers).
B70_MTP_DRAFT_PREFILL_NO_PIECEWISE=1

PYTORCH_ALLOC_CONF=pinned_max_cached_size_mb:1024

# the flag file of this engine (compose-serve.sh reads it)
SERVE_ARGS_FILE=/b70-engines/one-card/args/serve-tp1.args
