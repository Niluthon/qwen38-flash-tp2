# Local overrides for the four-card compose engine: copy to engines/four-cards/env/tp4-local.env (git-ignored) and
# uncomment what you change. Values here win over engines/four-cards/env/tp4.env. Apply with `docker compose up -d`.
# Format: KEY=value, no quotes, no variable expansion (docker env-file rules).

# --- extra `vllm serve` flags (appended to engines/four-cards/args/serve-tp4.args; the last value of a flag wins) ----
# A host-RAM KV tier (the release used 128 GiB on a 256 GB host; leave ~30 GiB of RAM free for the rest):
#EXTRA_ARGS=--kv-offloading-backend native --kv-offloading-size 64
#EXTRA_ARGS=--max-model-len 131072 --gpu-memory-utilization 0.90

# --- FP8 dense layers (0045): ~0.9 GiB per card more KV, quality-checked on two cards ------------------------------
#B70_DENSE_FP8=(linear_attn\.(in_proj_qkv|in_proj_z|in_proj_qkvz|out_proj)|self_attn\.(qkv_proj|q_proj|k_proj|v_proj|o_proj))$

# --- PLE row cache (pinned host RAM, in total) ------------------------------------------------------------------------
#B70_PLE_INT8_NVME_CACHE_GIB=8
