# Host-side settings for compose.yaml: copy to .env (git-ignored) if the defaults do not fit.
#MODELS=/home/you/models      # weights; `docker compose run --rm prepare` fills it (~185 GB; put it on NVMe)
#ENGINE_DATA=./engine-data    # the engine's caches and engine.log (default: engine-data/ in this repository)
#IMAGE=b70-flash-next:tp2     # the image `docker compose build` produces
#HF_TOKEN=hf_...              # only if your Hugging Face access needs one (the checkpoint is public)
#ENGINE_ENV=engines/one-card/env/tp1-hotcold.env        # the engine setup (default: two cards, engines/two-cards/env/tp2-hotcold.env)
#ENGINE_LOCAL_ENV=engines/one-card/env/tp1-local.env    # its local overrides (default: engines/two-cards/env/tp2-local.env)
